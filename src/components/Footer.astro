---
const stripeLink = "https://buy.stripe.com/bJe6oG4ea1codbO2FDa7C0e";
---

<footer class="bg-white border-t-4 border-black py-24">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Top Row -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-16 mb-20">

      <!-- Branding -->
      <div>
        <h3 class="text-4xl font-black text-[#0F172A] mb-4">
          Astro SaaS Launcher
        </h3>
        <p class="text-xl text-[#475569] font-medium max-w-sm leading-snug">
          A fully‑working SaaS starter application with Supabase fully integrated.
          Not a theme. Not a UI kit. A real foundation for your next product.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="grid grid-cols-2 gap-12 text-xl font-medium text-[#0F172A]">

        <div class="space-y-3">
          <a href="/" class="hover:underline">Home</a>
          <a href="#pricing" class="hover:underline">Pricing</a>
          <a href="/demo" class="hover:underline">Live Demo</a>
        </div>

        <div class="space-y-3">
          <a href="https://github.com" class="hover:underline">GitHub</a>
          <a href="mailto:support@example.com" class="hover:underline">Support</a>
          <a href="/docs" class="hover:underline">Docs</a>
        </div>

      </div>

    </div>

    <!-- CTA Block -->
    <div class="border-4 border-black bg-[#0F172A] text-white shadow-[10px_10px_0_0_#000] p-12 mb-20">

      <h4 class="text-3xl md:text-4xl font-black mb-6">
        Launch your SaaS faster — start with a real foundation.
      </h4>

      <p class="text-xl text-white/80 font-medium mb-10 max-w-2xl">
        Supabase Auth, Database, Storage, Realtime, RLS, billing, dashboard, protected routes — 
        all wired together and running out of the box.
      </p>

      <a href={stripeLink}
         class="inline-block px-12 py-4 text-2xl font-black bg-white text-[#0F172A] border-4 border-white shadow-[6px_6px_0_0_#000] hover:bg-[#0F172A] hover:text-white transition">
        Buy Now – £99
      </a>

    </div>

    <!-- Bottom Row -->
    <div class="flex flex-col md:flex-row justify-between items-center text-lg text-[#475569] font-medium">

      <p>© {new Date().getFullYear()} Astro SaaS Launcher. All rights reserved.</p>

      <div class="flex gap-6 mt-6 md:mt-0">
        <a href="/terms" class="hover:underline">Terms</a>
        <a href="/privacy" class="hover:underline">Privacy</a>
      </div>

    </div>

  </div>
</footer>

