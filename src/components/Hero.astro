---
import Button from "../components/ui/Button.astro";
---

<section class="relative overflow-hidden py-32 bg-white">

  <!-- Background Scribbles -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none -z-10"
       viewBox="0 0 1600 900" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M -200 300 C 200 150, 600 450, 1000 250 S 1600 350, 1800 200"
          stroke="#A259FF" stroke-width="6"
          stroke-linecap="round" stroke-linejoin="round"
          class="animate-scribble-1 opacity-40" />
    <path d="M -150 500 C 250 350, 650 650, 1050 450 S 1650 550, 1850 400"
          stroke="#3C82F6" stroke-width="5"
          stroke-linecap="round" stroke-linejoin="round"
          class="animate-scribble-2 opacity-30" />
    <path d="M -100 700 C 300 550, 700 850, 1100 650 S 1700 750, 1900 600"
          stroke="#FF5F7E" stroke-width="4"
          stroke-linecap="round" stroke-linejoin="round"
          class="animate-scribble-3 opacity-25" />
  </svg>

  <div class="relative mx-auto max-w-5xl px-6 text-left">

    <!-- Brutalist Headline -->
    <h1 class="text-6xl md:text-8xl font-black tracking-tight leading-[0.9] text-[#0F172A]">
      Launch your SaaS.<br />
      <span class="inline-block -rotate-1 px-2 bg-[#FF5F7E] text-white">
        Not a theme.
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="mt-8 text-xl max-w-2xl text-[#475569] leading-relaxed font-semibold">
      Astro SaaS Launcher is a fully‑working SaaS starter application — not a UI kit or design theme.  
      It ships with real boilerplate code every SaaS needs: authentication, database models, storage, realtime, billing, dashboard, protected routes, and a modern UI.  
      Built on Astro, Svelte, and Supabase, it runs out of the box and saves weeks or even months of development time.
    </p>

    <!-- CTA Buttons -->
    <div class="mt-10 flex gap-6">
      <Button href="/pricing" variant="primary" size="lg">
        View Pricing
      </Button>

      <Button href="/demo" variant="outline" size="lg">
        Live Demo
      </Button>
    </div>

  </div>
</section>

<style>
  @keyframes scribble-1 {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -80; transform: translateY(-12px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }
  @keyframes scribble-2 {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -120; transform: translateY(10px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }
  @keyframes scribble-3 {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -60; transform: translateY(-8px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }

  .animate-scribble-1 { animation: scribble-1 6s ease-in-out infinite; }
  .animate-scribble-2 { animation: scribble-2 7s ease-in-out infinite; }
  .animate-scribble-3 { animation: scribble-3 5s ease-in-out infinite; }
</style>

