---
const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
} = Astro.props;

const baseClasses = `
  inline-flex items-center justify-center
  font-black tracking-tight uppercase
  border-[4px] rounded-md
  shadow-[6px_6px_0_#0F172A]
  transition-colors transition-shadow duration-150
  active:shadow-[3px_3px_0_#0F172A]
  active:translate-x-[3px] active:translate-y-[3px]
`;

const variantClasses = {
  primary: `
    bg-[#0F172A] text-white border-[#0F172A]
    hover:bg-[#3C82F6] hover:border-[#3C82F6]
  `,
  outline: `
    bg-white text-[#0F172A] border-[#0F172A]
    hover:bg-[#FF5F7E] hover:border-[#FF5F7E] hover:text-white
  `,
  nav: `
    bg-white text-[#0F172A] border-[#0F172A]
    hover:bg-[#A259FF] hover:border-[#A259FF] hover:text-white
  `,
  accent: `
    bg-[#FF5F7E] text-white border-[#0F172A]
    hover:bg-[#FF2F5E] hover:border-[#FF2F5E]
  `,
  electric: `
    bg-[#A259FF] text-white border-[#0F172A]
    hover:bg-[#7A1FFF] hover:border-[#7A1FFF]
  `,
};

const sizeClasses = {
  sm: "text-sm px-4 py-2",
  md: "text-base px-6 py-3",
  lg: "text-lg px-8 py-4",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}

