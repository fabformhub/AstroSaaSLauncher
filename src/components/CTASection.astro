---
import Button from "../components/ui/Button.astro";
const stripeLink = "https://buy.stripe.com/bJe6oG4ea1codbO2FDa7C0e";
---

<section class="py-40 bg-[#0F172A] text-white relative overflow-hidden">

  <!-- Background Accent -->
  <svg class="absolute -top-10 -left-10 w-[500px] opacity-20 pointer-events-none -z-10"
       viewBox="0 0 600 300" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M20 200 C140 40, 260 260, 420 80 S580 200, 590 40"
          stroke="#FF5F7E" stroke-width="6" stroke-linecap="round"
          class="animate-scribble-cta" />
  </svg>

  <div class="mx-auto max-w-4xl px-6 text-center">

    <h2 class="text-5xl md:text-7xl font-black tracking-tight leading-[0.9] mb-10">
      Stop rebuilding boilerplate.<br />
      <span class="inline-block -rotate-1 px-3 bg-white text-[#0F172A]">
        Start building your SaaS.
      </span>
    </h2>

    <p class="text-2xl md:text-3xl font-semibold text-white/80 max-w-3xl mx-auto leading-snug mb-14">
      Astro SaaS Launcher gives you a fully‑working SaaS starter application with Supabase fully integrated — 
      Auth, Database, Storage, Realtime, RLS, billing, dashboard, and protected routes.  
      It runs out of the box and saves you weeks or months of development time.
    </p>

    <!-- Value Row -->
    <div class="flex flex-col md:flex-row justify-center gap-8 text-xl font-medium mb-14">

      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 mt-1 text-white" viewBox="0 0 16 16">
          <path d="M6.5 11.5L3 8l1.4-1.4L6.5 8.7l5.1-5.1L13 5l-6.5 6.5z" fill="currentColor"/>
        </svg>
        <span>Pay once — own the code</span>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 mt-1 text-white" viewBox="0 0 16 16">
          <path d="M6.5 11.5L3 8l1.4-1.4L6.5 8.7l5.1-5.1L13 5l-6.5 6.5z" fill="currentColor"/>
        </svg>
        <span>Supabase fully integrated</span>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 mt-1 text-white" viewBox="0 0 16 16">
          <path d="M6.5 11.5L3 8l1.4-1.4L6.5 8.7l5.1-5.1L13 5l-6.5 6.5z" fill="currentColor"/>
        </svg>
        <span>Launch weeks or months faster</span>
      </div>

    </div>

    <!-- CTA Button -->
    <a href={stripeLink}
       class="inline-block text-center w-full md:w-auto px-16 py-5 text-3xl font-black bg-white text-[#0F172A] border-4 border-white shadow-[8px_8px_0_0_#000] hover:bg-[#0F172A] hover:text-white hover:border-white transition">
      Buy Now – £99
    </a>

  </div>
</section>

<style>
  @keyframes scribble-cta {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -100; transform: translateY(-10px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }

  .animate-scribble-cta {
    animation: scribble-cta 7s ease-in-out infinite;
  }
</style>

