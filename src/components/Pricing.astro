---
import Button from "../components/ui/Button.astro";
---

<section class="relative py-40 bg-white overflow-hidden">

  <!-- Background Scribble -->
  <svg class="absolute top-0 left-0 w-[600px] opacity-40 pointer-events-none -z-10"
       viewBox="0 0 600 300" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 150 C120 20, 260 260, 400 80 S580 200, 590 40"
          stroke="#FF5F7E" stroke-width="6" stroke-linecap="round"
          class="animate-scribble-pricing" />
  </svg>

  <div class="mx-auto max-w-6xl px-6">

    <!-- Section Heading -->
    <h2 class="text-5xl md:text-7xl font-black tracking-tight leading-[0.9] text-[#0F172A] mb-20">
      Pricing that’s<br />
      <span class="inline-block -rotate-1 px-2 bg-[#3C82F6] text-white">
        brutally fair.
      </span>
    </h2>

    <!-- Pricing Grid -->
    <div class="grid md:grid-cols-2 gap-20">

      <!-- Starter Plan -->
      <div class="relative p-12 border-4 border-[#0F172A] rounded-xl bg-white shadow-[10px_10px_0_#0F172A] hover:shadow-[14px_14px_0_#A259FF] transition-all duration-300">

        <!-- Scribble Accent -->
        <svg class="absolute -top-6 -left-4 w-36 opacity-60 pointer-events-none"
             viewBox="0 0 200 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 30 C40 5, 80 55, 120 20 S180 40, 195 10"
                stroke="#A259FF" stroke-width="4" stroke-linecap="round"
                class="animate-scribble-card" />
        </svg>

        <h3 class="text-4xl font-black mb-4">Starter</h3>
        <p class="text-lg text-[#475569] mb-8 leading-relaxed">
          Perfect for indie hackers, prototypes, and early‑stage experiments.
        </p>

        <div class="text-6xl font-black mb-8">€49</div>

        <ul class="space-y-3 text-lg text-[#0F172A] font-semibold">
          <li>✔ Full UI System</li>
          <li>✔ Scribble Motion Engine</li>
          <li>✔ All Components</li>
          <li>✔ Lifetime Updates</li>
        </ul>

        <div class="mt-10">
          <Button href="/checkout" variant="outline" size="lg">
            Get Starter
          </Button>
        </div>
      </div>

      <!-- Pro Plan -->
      <div class="relative p-12 border-4 border-[#0F172A] rounded-xl bg-white shadow-[10px_10px_0_#0F172A] hover:shadow-[14px_14px_0_#FF5F7E] transition-all duration-300">

        <!-- Scribble Accent -->
        <svg class="absolute -top-6 -left-4 w-36 opacity-60 pointer-events-none"
             viewBox="0 0 200 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 30 C40 5, 80 55, 120 20 S180 40, 195 10"
                stroke="#FF5F7E" stroke-width="4" stroke-linecap="round"
                class="animate-scribble-card" />
        </svg>

        <h3 class="text-4xl font-black mb-4">Pro</h3>
        <p class="text-lg text-[#475569] mb-8 leading-relaxed">
          For founders, agencies, and teams who want a premium, expressive SaaS.
        </p>

        <div class="text-6xl font-black mb-8">€499</div>

        <ul class="space-y-3 text-lg text-[#0F172A] font-semibold">
          <li>✔ Everything in Starter</li>
          <li>✔ Full Dashboard Shell</li>
          <li>✔ Auth Pages</li>
          <li>✔ Advanced Motion System</li>
          <li>✔ Commercial License</li>
        </ul>

        <div class="mt-10">
          <Button href="/checkout" variant="primary" size="lg">
            Get Pro
          </Button>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes scribble-pricing {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -120; transform: translateY(12px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }

  .animate-scribble-pricing {
    animation: scribble-pricing 8s ease-in-out infinite;
  }
</style>

