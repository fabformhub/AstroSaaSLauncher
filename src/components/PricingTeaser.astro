---
import Button from "../components/ui/Button.astro";
const stripeLink = "https://buy.stripe.com/bJe6oG4ea1codbO2FDa7C0e";
---

<section class="relative py-40 bg-white overflow-hidden">

  <!-- Background Scribble -->
  <svg class="absolute top-0 right-0 w-[600px] opacity-40 pointer-events-none -z-10"
       viewBox="0 0 600 300" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 150 C120 20, 260 260, 400 80 S580 200, 590 40"
          stroke="#A259FF" stroke-width="6" stroke-linecap="round"
          class="animate-scribble-teaser" />
  </svg>

  <div class="mx-auto max-w-5xl px-6 text-left">

    <!-- Brutalist Heading -->
    <h2 class="text-6xl md:text-8xl font-black tracking-tight leading-[0.9] text-[#0F172A] mb-10">
      Pricing built<br />
      <span class="inline-block -rotate-1 px-2 bg-[#FF5F7E] text-white">
        for builders.
      </span>
    </h2>

    <!-- Subheadline -->
    <p class="text-2xl md:text-3xl font-semibold text-[#475569] max-w-3xl leading-snug">
      One simple price for a fully‑working SaaS starter application — not a theme, not a UI kit.  
      Astro SaaS Launcher ships with Supabase fully integrated, real boilerplate code, and everything you need to launch your SaaS faster.
    </p>

    <!-- Feature Accent Row -->
    <div class="mt-10 flex flex-col gap-4 text-xl font-medium text-[#1E293B]">

      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 mt-1 text-black" viewBox="0 0 16 16">
          <path d="M6.5 11.5L3 8l1.4-1.4L6.5 8.7l5.1-5.1L13 5l-6.5 6.5z" fill="currentColor"/>
        </svg>
        <span>Full Supabase integration — Auth, DB, Storage, Realtime, RLS</span>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 mt-1 text-black" viewBox="0 0 16 16">
          <path d="M6.5 11.5L3 8l1.4-1.4L6.5 8.7l5.1-5.1L13 5l-6.5 6.5z" fill="currentColor"/>
        </svg>
        <span>Real boilerplate code — not placeholders or mockups</span>
      </div>

      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 mt-1 text-black" viewBox="0 0 16 16">
          <path d="M6.5 11.5L3 8l1.4-1.4L6.5 8.7l5.1-5.1L13 5l-6.5 6.5z" fill="currentColor"/>
        </svg>
        <span>Runs out of the box — launch weeks or months faster</span>
      </div>

    </div>

    <!-- CTA -->
    <div class="mt-14">
      <a href={stripeLink}>
        <Button variant="primary" size="lg">
          Buy Now – £99
        </Button>
      </a>
    </div>

  </div>
</section>

<style>
  @keyframes scribble-teaser {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -100; transform: translateY(-10px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }

  .animate-scribble-teaser {
    animation: scribble-teaser 7s ease-in-out infinite;
  }
</style>

