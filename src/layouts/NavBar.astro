---
import Button from "../components/ui/Button.astro";
---

<nav class="w-full border-b-4 border-[#0F172A] bg-white px-8 py-6 flex justify-between items-center">

  <!-- Logo -->
  <a href="/" class="text-3xl font-black tracking-tight">
    Astro SaaS Launcher
  </a>

  <!-- Desktop Nav -->
  <div class="hidden md:flex items-center gap-6">
    <Button href="/pricing" variant="nav" size="md">Pricing</Button>
    <Button href="/docs" variant="nav" size="md">Docs</Button>
    <Button href="/contact" variant="nav" size="md">Contact</Button>
  </div>

  <!-- Desktop CTA -->
  <div class="hidden md:flex items-center gap-6">
    <Button href="/login" variant="outline" size="md">Login</Button>
    <Button href="/signup" variant="primary" size="md">Get Started</Button>
  </div>

  <!-- Mobile Menu Button -->
  <button id="mobileMenuButton" class="md:hidden text-3xl font-black">
    ☰
  </button>

</nav>

<!-- Mobile Menu -->
<div id="mobileMenu" class="md:hidden hidden border-b-4 border-[#0F172A] bg-white px-8 py-6 space-y-6">

  <Button href="/pricing" variant="nav" size="lg" class="block w-full text-left">Pricing</Button>
  <Button href="/docs" variant="nav" size="lg" class="block w-full text-left">Docs</Button>
  <Button href="/contact" variant="nav" size="lg" class="block w-full text-left">Contact</Button>

  <div class="pt-4 border-t-4 border-[#0F172A]">
    <Button href="/login" variant="outline" size="lg" class="block w-full text-left mb-4">Login</Button>
    <Button href="/signup" variant="primary" size="lg" class="block w-full text-left">Get Started</Button>
  </div>

</div>

<script>
  const btn = document.getElementById("mobileMenuButton");
  const menu = document.getElementById("mobileMenu");

  btn.addEventListener("click", () => {
    menu.classList.toggle("hidden");
  });
</script>

