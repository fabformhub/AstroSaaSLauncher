---
import Button from "../components/ui/Button.astro";
---

<section class="min-h-screen flex items-center justify-center bg-white relative overflow-hidden">

  <!-- Background Scribble -->
  <svg class="absolute top-0 left-0 w-[700px] opacity-40 pointer-events-none -z-10"
       viewBox="0 0 700 400" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M20 200 C150 40, 300 360, 450 120 S650 260, 690 80"
          stroke="#A259FF" stroke-width="7" stroke-linecap="round"
          class="animate-scribble-auth" />
  </svg>

  <div class="w-full max-w-md p-12 border-4 border-[#0F172A] rounded-xl bg-white shadow-[12px_12px_0_#0F172A]">

    <h1 class="text-5xl font-black text-[#0F172A] mb-6">
      Set a new password
    </h1>

    <p class="text-lg text-[#475569] font-semibold mb-10 leading-relaxed">
      Enter your new password below.
    </p>

    <form method="post" class="space-y-8">

      <div>
        <label class="block text-lg font-bold mb-2">New Password</label>
        <input type="password"
               class="w-full px-5 py-4 border-4 border-[#0F172A] rounded-md text-lg font-semibold focus:outline-none"
               required />
      </div>

      <div>
        <label class="block text-lg font-bold mb-2">Confirm Password</label>
        <input type="password"
               class="w-full px-5 py-4 border-4 border-[#0F172A] rounded-md text-lg font-semibold focus:outline-none"
               required />
      </div>

      <div class="pt-4">
        <Button variant="primary" size="lg">
          Update Password
        </Button>
      </div>

    </form>

    <div class="mt-10 flex flex-col gap-4 text-lg font-semibold">
      <a href="/login" class="underline text-[#0F172A]">Back to login</a>
    </div>

  </div>
</section>

<style>
  @keyframes scribble-auth {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -140; transform: translateY(-14px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }

  .animate-scribble-auth {
    animation: scribble-auth 8s ease-in-out infinite;
  }
</style>
