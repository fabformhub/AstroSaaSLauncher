---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact – Astro SaaS Launcher">

<section class="py-40 bg-white relative overflow-hidden">

  <!-- Background Accent -->
  <svg class="absolute top-0 right-0 w-[600px] opacity-30 pointer-events-none -z-10"
       viewBox="0 0 600 300" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 150 C120 20, 260 260, 400 80 S580 200, 590 40"
          stroke="#A259FF" stroke-width="6" stroke-linecap="round"
          class="animate-scribble-contact" />
  </svg>

  <div class="mx-auto max-w-4xl px-6">

    <!-- Heading -->
    <h1 class="text-6xl md:text-8xl font-black tracking-tight leading-[0.9] text-[#0F172A] mb-10">
      Get in touch.<br />
      <span class="inline-block -rotate-1 px-3 bg-[#FF5F7E] text-white">
        We’d love to hear from you.
      </span>
    </h1>

    <p class="text-2xl text-[#475569] font-semibold max-w-2xl leading-snug mb-16">
      Whether you have a question about Astro SaaS Launcher, need help getting started, 
      or want to discuss something specific — drop us a message and we’ll get back to you.
    </p>

    <!-- Contact Form -->
    <form 
      action="https://fabform.io/f/2vBBPjg"
      method="POST"
      class="border-4 border-black bg-white shadow-[12px_12px_0_0_#000] p-12 space-y-10"
    >

      <!-- Name -->
      <div>
        <label class="block text-xl font-black text-[#0F172A] mb-2">Your Name</label>
        <input 
          type="text" 
          name="name" 
          required
          class="w-full border-4 border-black px-4 py-3 text-xl focus:outline-none focus:bg-yellow-100"
        />
      </div>

      <!-- Email -->
      <div>
        <label class="block text-xl font-black text-[#0F172A] mb-2">Email Address</label>
        <input 
          type="email" 
          name="email" 
          required
          class="w-full border-4 border-black px-4 py-3 text-xl focus:outline-none focus:bg-yellow-100"
        />
      </div>

      <!-- Message -->
      <div>
        <label class="block text-xl font-black text-[#0F172A] mb-2">Message</label>
        <textarea 
          name="message" 
          rows="6" 
          required
          class="w-full border-4 border-black px-4 py-3 text-xl focus:outline-none focus:bg-yellow-100"
        ></textarea>
      </div>

      <!-- Submit -->
      <button 
        type="submit"
        class="w-full md:w-auto px-16 py-5 text-3xl font-black bg-[#0F172A] text-white border-4 border-black shadow-[8px_8px_0_0_#000] hover:bg-white hover:text-[#0F172A] transition"
      >
        Send Message
      </button>

    </form>

  </div>
</section>

<style>
  @keyframes scribble-contact {
    0% { stroke-dashoffset: 0; transform: translateY(0px); }
    50% { stroke-dashoffset: -100; transform: translateY(-10px); }
    100% { stroke-dashoffset: 0; transform: translateY(0px); }
  }

  .animate-scribble-contact {
    animation: scribble-contact 7s ease-in-out infinite;
  }
</style>

</BaseLayout>

